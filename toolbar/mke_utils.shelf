<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- This file contains definitions of shelves, toolbars, and tools.
 It should not be hand-edited when it is being used by the application.
 Note, that two definitions of the same element are not allowed in
 a single file. -->

  <toolshelf name="mke_tools" label="MKE Tools">
    <memberTool name="mke_houdinivsc"/>
    <memberTool name="mke_ratconverter"/>
    <memberTool name="mke_projectsetup"/>
    <memberTool name="mke_saveup"/>
  </toolshelf>

    <tool name="mke_ratconverter" label="RAT Converter" icon="mipmapGenerator_logo.svg">
      <script scriptType="python"><![CDATA[from ratConverter import RatGeneratorUI
import hou
main_window = hou.ui.mainQtWindow()
for widget in QtWidgets.QApplication.topLevelWidgets():
     if isinstance(widget, RatGeneratorUI):
         widget.close()
ui = RatGeneratorUI(parent=main_window)
ui.show()]]></script>
    </tool>

    <tool name="mke_projectsetup" label="Project Setup" icon="projectSetup_logo.svg">
      <script scriptType="python"><![CDATA[import projectSetup as setup
setup.projectSetup()]]></script>
    </tool>

    <tool name="mke_saveup" label="Save Up" icon="saveUp_logo.svg">
      <script scriptType="python"><![CDATA[import saveUp as saveUp
saveUp.saveUp()]]></script>
    </tool>

    <tool name="mke_houdinivsc" label="Houdini VSC" icon="houdinivsc_logo.svg">
      <script scriptType="python"><![CDATA[import houdiniVSC as houdinivsc
houdinivsc.houdiniVSC()]]></script>
    </tool>

      <tool name="usd_dependency_checker" label="USD Dependency Checker" icon="BUTTONS_usd">
    <script scriptType="python">
<![CDATA[
import mke_usd_dependancy
mke_usd_dependancy.main()
]]>
    </script>
    <help>
<![CDATA[
USD Dependency Checker

Analyzes USD files for all dependencies and identifies files that are not located on the configured server path.

Features:
- Scans USD files for textures, Alembic files, and USD references
- Identifies missing files with visual indicators
- Highlights files not on server drive (configurable path)
- Categorizes dependencies by type (textures, geometry, USD files)
- Context menu with copy/open location options
- Detailed usage statistics and file locations
- Configurable server path with persistent settings
- Works with HDA parameters or manual file selection

The tool will show a detailed report of all off-server dependencies with options to manage them.
]]>
    </help>
  </tool>

  <tool name="usd_dependency_config" label="Configure Server Path" icon="BUTTONS_gear">
    <script scriptType="python">
<![CDATA[
import mke_usd_dependancy
mke_usd_dependancy.configure()
]]>
    </script>
    <help>
<![CDATA[
Configure Server Path

Opens the configuration dialog to set the server path used by the USD Dependency Checker.

This allows you to customize what path is considered the "server" when checking if files are properly located for rendering.

Examples:
- Windows: W:/ or Z:/projects/
- Linux/Mac: /mnt/server/ or /Volumes/Server/

Settings are saved persistently for future sessions.
]]>
    </help>
  </tool>

</shelfDocument>

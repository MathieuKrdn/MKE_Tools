<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- This file contains definitions of shelves, toolbars, and tools.
 It should not be hand-edited when it is being used by the application.
 Note, that two definitions of the same element are not allowed in
 a single file. -->

  <toolshelf name="mke_tools" label="MKE Tools">
    <memberTool name="mke_ratconverter"/>
    <memberTool name="mke_projectsetup"/>
    <memberTool name="mke_saveup"/>
    <memberTool name="usd_dependency_checker"/>
    <memberTool name="usd_dependency_config"/>
    <memberTool name="lineup"/>
  </toolshelf>

    <tool name="mke_ratconverter" label="RAT Converter" icon="mipmapGenerator_logo.svg">
      <script scriptType="python"><![CDATA[from ratConverter import RatGeneratorUI
import hou
main_window = hou.ui.mainQtWindow()
for widget in QtWidgets.QApplication.topLevelWidgets():
     if isinstance(widget, RatGeneratorUI):
         widget.close()
ui = RatGeneratorUI(parent=main_window)
ui.show()]]></script>
    </tool>

    <tool name="mke_projectsetup" label="Project Setup" icon="projectSetup_logo.svg">
      <script scriptType="python"><![CDATA[import projectSetup as setup
setup.projectSetup()]]></script>
    </tool>

    <tool name="mke_saveup" label="Save Up" icon="saveUp_logo.svg">
      <script scriptType="python"><![CDATA[import saveUp as saveUp
saveUp.saveUp()]]></script>
    </tool>

  <tool name="usd_dependency_checker" label="USD Dependency Checker" icon="BUTTONS_usd">
    <script scriptType="python"><![CDATA[import mke_usd_dependancy
import hou

# Get server path from environment or use default
server_path = hou.getenv("MKE_SERVER_PATH", "W:/")

# Get current HDA node or use file selection
selected_nodes = hou.selectedNodes()
usd_file = None

if selected_nodes and len(selected_nodes) == 1:
    node = selected_nodes[0]
    if node.type().definition():
        # Try to get USD file from common parameter names
        for parm_name in ['file', 'filepath', 'usdfile', 'filename']:
            if node.parm(parm_name):
                usd_file = node.parm(parm_name).eval()
                break

if not usd_file:
    # Ask user to select USD file
    usd_file = hou.ui.selectFile(title="Select USD File", pattern="*.usd,*.usda,*.usdc")

if usd_file:
    mke_usd_dependancy.start_with_file(usd_file, server_path)]]></script>
  </tool>

  <tool name="usd_dependency_config" label="Configure Server Path" icon="BUTTONS_gear">
    <script scriptType="python"><![CDATA[import hou

# Get current server path
current_path = hou.getenv("MKE_SERVER_PATH", "W:/")

# Ask user for new server path
new_path = hou.ui.readInput("Configure Server Path", 
                            buttons=("OK", "Cancel"),
                            default_choice=0,
                            initial_contents=current_path,
                            title="USD Dependency Checker Configuration")[1]

if new_path:
    hou.putenv("MKE_SERVER_PATH", new_path)
    hou.ui.displayMessage(f"Server path set to: {new_path}")]]></script>
  </tool>

  <tool name="lineup" label="Line Up Objects" icon="lineup_logo.svg">
    <script scriptType="python"><![CDATA[import lineup
lineup.lineup()]]></script>
  </tool>

</shelfDocument>
